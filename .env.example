# Email Configuration for Admin Notifications
ADMIN_EMAIL=your-email@gmail.com
ADMIN_PASSWORD=your-admin-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=your-email@gmail.com

# Session signing key for logins (leave empty to auto-generate .secret_key file)
SECRET_KEY=

# Public site URL used for sitemap/robots (no trailing slash)
SITE_URL=https://util.techintricks.in

# Allowed CORS origins for separate frontend hosting (comma-separated)
CORS_ORIGINS=https://techintricks.online

# Database: set MYSQL_HOST to use MySQL; otherwise the app falls back to SQLite.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=utility_user
MYSQL_PASSWORD=change-this-password
MYSQL_DATABASE=utility_system
MAX_FILES_PER_USER=100
MAX_TOTAL_MB=500

# OAuth: Google (get from https://console.cloud.google.com/apis/credentials)
# Create OAuth 2.0 Client ID (Web application), add authorized redirect URI:
#   https://util.techintricks.in/oauth/google/callback
# For local dev, also add: http://localhost:5000/oauth/google/callback
GOOGLE_CLIENT_ID=

# OAuth: GitHub (get from https://github.com/settings/developers)
# Create OAuth App, set callback URL to:
#   https://util.techintricks.in/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# OAuth: Facebook (get from https://developers.facebook.com/apps)
# Create Facebook Login app, set Valid OAuth Redirect URI to:
#   https://util.techintricks.in/oauth/facebook/callback
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
